# Copy to `.env` in this folder (or keep the repo’s `.env` only on your machine).
# Expo loads `EXPO_PUBLIC_*` from `.env` when you run `npx expo start`.
# `.env` is gitignored so your machine’s API URL is not committed.

# Backend API (no trailing slash). Use LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000
