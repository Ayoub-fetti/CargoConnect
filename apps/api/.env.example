MONGODB_URI=mongodb://localhost:27017/cargoconnect
PORT=3000

# JWT
JWT_SECRET=YOUR-JWT_SECRET
JWT_EXPIRATION=7d

# JWT refresh token 
JWT_REFRESH_SECRET=YOUR-JWT-REFRESH-SECRET
JWT_REFRESH_EXPIRATION=30d


# Email - Mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=5*********4
SMTP_PASSWORD=a********0
SMTP_FROM=noreply@cargoconnect.com

# App
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_1_MONTH=price_...
STRIPE_PRICE_3_MONTHS=price_...
STRIPE_PRICE_1_YEAR=price_...

# commande to get stripe webhook 
stripe listen \
  --events checkout.session.completed,invoice.payment_succeeded,invoice.payment_failed,customer.subscription.deleted \
  --forward-to localhost:3000/api/subscriptions/webhook


